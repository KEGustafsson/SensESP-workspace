#!/usr/bin/env bash
#
# usage: ./run command [argument ...]
#
# Commands for managing the SensESP workspace.
#
# See https://death.andgravity.com/run-sh
# for an explanation of how it works and why it's useful.

set -o nounset
set -o pipefail
set -o errexit

# Change the current directory to the project root.
PROJECT_ROOT=${0%/*}
if [[ $0 != $PROJECT_ROOT && $PROJECT_ROOT != "" ]]; then
  cd "$PROJECT_ROOT"
fi
readonly PROJECT_ROOT=$(pwd)

readonly SCRIPT="$PROJECT_ROOT/$(basename "$0")"

################################################################################
# Repository Definitions
#
# Format: name url branch
# Using a function instead of associative arrays for bash 3.2 compatibility
# (macOS ships bash 3.2 which lacks declare -A).

repo_list() {
  cat <<'REPOS'
SensESP                    https://github.com/SignalK/SensESP.git                     main
ReactESP                   https://github.com/mairas/ReactESP.git                     master
NMEA0183                   https://github.com/SensESP/NMEA0183.git                    main
OneWire                    https://github.com/SensESP/OneWire.git                     main
VEDirect                   https://github.com/SensESP/VEDirect.git                    main
MAX31856                   https://github.com/SensESP/MAX31856.git                    main
SensESP-project-template   https://github.com/SensESP/SensESP-project-template.git    main
Tutorial-BMP280            https://github.com/SensESP/Tutorial-BMP280.git             main
HALMET-example-firmware    https://github.com/hatlabs/HALMET-example-firmware.git      main
HALSER-default-firmware    https://github.com/hatlabs/HALSER-default-firmware.git      main
HALSER-ais-interface       https://github.com/hatlabs/HALSER-ais-interface.git         main
HALSER-wind-interface      https://github.com/hatlabs/HALSER-wind-interface.git        main
SH-ESP32-engine-hat-firmware https://github.com/hatlabs/SH-ESP32-engine-hat-firmware.git main
SH-wg-firmware             https://github.com/hatlabs/SH-wg-firmware.git              main
lumi-alarm                 https://github.com/mairas/lumi-alarm.git                   main
REPOS
}

# Source additional repository definitions if present.
for f in "$PROJECT_ROOT"/repos.*.sh; do
  if [[ -f "$f" ]]; then
    source "$f"
  fi
done

################################################################################
# Initialization

function init {
  #@ Set up the workspace: install tools, clone reference repos
  #@ Category: Setup

  echo "Setting up SensESP workspace..."
  echo ""

  # Check git
  if ! command -v git &> /dev/null; then
    echo "ERROR: git is not installed."
    echo "Please install git and try again."
    exit 1
  fi
  echo "  git: $(git --version)"

  # Check python3
  if ! command -v python3 &> /dev/null; then
    echo "ERROR: python3 is not installed."
    echo "Please install Python 3 and try again."
    exit 1
  fi
  echo "  python3: $(python3 --version)"

  # Check/install uv
  if ! command -v uv &> /dev/null; then
    echo ""
    echo "Installing uv (Python package manager)..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
    # Source the updated PATH
    export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
    if ! command -v uv &> /dev/null; then
      echo "ERROR: uv installation failed."
      echo "Please install uv manually: https://docs.astral.sh/uv/getting-started/installation/"
      exit 1
    fi
  fi
  echo "  uv: $(uv --version)"

  # Check/install PlatformIO
  if ! command -v pio &> /dev/null; then
    echo ""
    echo "Installing PlatformIO..."
    uv tool install platformio
    if ! command -v pio &> /dev/null; then
      echo "WARNING: PlatformIO installation may require restarting your shell."
      echo "After restarting, verify with: pio --version"
    fi
  fi
  if command -v pio &> /dev/null; then
    echo "  pio: $(pio --version 2>&1 | head -1)"
  fi

  # Install pyserial for serial monitoring
  echo ""
  echo "Installing pyserial..."
  uv pip install --system pyserial 2>/dev/null || pip3 install pyserial 2>/dev/null || true

  # Create directories
  mkdir -p ref projects

  # Clone repos
  echo ""
  repos:clone

  # Platform-specific guidance
  echo ""
  _platform_guidance

  echo ""
  echo "=========================================="
  echo "  Workspace setup complete!"
  echo ""
  echo "  Next steps:"
  echo "    1. Open Claude Code in this directory"
  echo "    2. Describe what you want to build"
  echo ""
  echo "  Example:"
  echo "    \"I want to monitor my engine"
  echo "     temperature using HALMET\""
  echo "=========================================="
}

function _platform_guidance {
  # Detect platform and provide relevant guidance
  local system
  system="$(uname -s)"

  case "$system" in
    Linux)
      # Check for WSL
      if grep -qi microsoft /proc/version 2>/dev/null; then
        echo "NOTE: WSL detected."
        echo "  USB devices require usbipd-win for passthrough."
        echo "  See: https://learn.microsoft.com/en-us/windows/wsl/connect-usb"
      else
        # Check dialout group
        if ! groups | grep -q dialout 2>/dev/null; then
          echo "NOTE: You may need to add yourself to the 'dialout' group"
          echo "  for serial port access:"
          echo "    sudo usermod -a -G dialout \$USER"
          echo "  Then log out and back in."
        fi
      fi
      ;;
  esac
}

################################################################################
# Repository Management Commands

function repos:clone {
  #@ Clone any missing reference repos into ref/
  #@ Category: Repository Management
  echo "Checking reference repositories..."

  local cloned=0
  local skipped=0
  local failed=0

  repo_list | grep -v '^#' | grep -v '^\s*$' | while read -r name url branch; do
    if [[ -d "ref/$name" ]]; then
      echo "  $name (already cloned)"
      # Can't increment skipped in subshell, but that's OK for display
    else
      echo "  Cloning $name..."
      if git clone --depth 1 -b "$branch" "$url" "ref/$name" 2>/dev/null; then
        echo "    Done."
      else
        echo "    WARNING: Failed to clone $name. Skipping."
      fi
    fi
  done

  echo ""
  echo "Reference repos are in ref/"
}

function repos:pull {
  #@ Update all reference repos to latest
  #@ Category: Repository Management
  echo "Updating reference repositories..."

  repo_list | grep -v '^#' | grep -v '^\s*$' | while read -r name url branch; do
    if [[ ! -d "ref/$name" ]]; then
      echo "  $name: not cloned (run ./run repos:clone)"
      continue
    fi

    echo "  Updating $name..."
    if (cd "ref/$name" && git pull --depth 1 origin "$branch" 2>/dev/null); then
      echo "    Done."
    else
      echo "    WARNING: Failed to update $name."
    fi
  done
}

function repos:status {
  #@ Show clone status of all reference repos
  #@ Category: Repository Management
  echo "Reference repository status:"
  echo ""

  repo_list | grep -v '^#' | grep -v '^\s*$' | while read -r name url branch; do
    if [[ -d "ref/$name" ]]; then
      local current_branch
      current_branch=$(cd "ref/$name" && git branch --show-current 2>/dev/null || echo "unknown")
      echo "  $name: cloned (branch: $current_branch)"
    else
      echo "  $name: NOT CLONED"
    fi
  done
}

################################################################################
# Help System

function help {
  #@ Show this help message
  #@ Category: Core
  echo "SensESP Workspace"
  echo ""
  echo "Available commands:"

  # Extract function definitions and their help comments
  awk '/^function / {
    fname = $2
    sub(/[({].*/, "", fname)
    if (fname ~ /^_/) next
    getline
    if ($0 ~ /#@/) {
      desc = $0
      sub(/.*#@ /, "", desc)
      sub(/ *$/, "", desc)
      getline
      if ($0 ~ /#@ Category:/) {
        cat = $0
        sub(/.*Category: /, "", cat)
        sub(/ *$/, "", cat)
        if (!seen[cat]++) categories[++cat_count] = cat
        commands[cat, ++cmd_count[cat]] = fname
        descriptions[cat, cmd_count[cat]] = desc
      }
    }
  }
  END {
    for (i = 1; i <= cat_count; i++) {
      cat = categories[i]
      print "\n  " cat ":"
      for (j = 1; j <= cmd_count[cat]; j++) {
        printf "    %-30s %s\n", commands[cat, j], descriptions[cat, j]
      }
    }
  }' "$0"

  echo ""
  echo "Usage: ./run <command> [arguments...]"
}

################################################################################
# Commands end.

# Support --help as an alias for help.
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  set -- help
fi

TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
